# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.js

# Production builds & artifacts
dist/
**/dist/
dist-ssr/
**/dist-ssr/
build/
**/build/
*.local

# Environment variables & secrets (Wajib diabaikan agar tidak bocor ke publik)
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Logs & debugging
*.log
logs/
**/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Database & SQLite temporary files
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
backend/data/*.db
backend/data/*.db-*
**/data/*.db
**/data/*.db-*

# OS & Editor files
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Windows executables & backup files
*.exe
*.exe~
*.dll
*.so
*.dylib
backend/adam-gateway*
cloudflared*
ecosystem.config.js
nginx.conf*
ram-watchdog*