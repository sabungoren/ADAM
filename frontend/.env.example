# ==============================================================================
# Project A.D.A.M - Frontend Environment Variables Template (.env.example)
# Salin file ini menjadi .env lalu sesuaikan dengan konfigurasi server Anda.
# ==============================================================================

# Local Vite Dev Server Port
PORT=5193
VITE_PORT=5193

# URL API Backend (Gunakan http://localhost:5194 saat dev lokal atau https://api.your-domain.com saat produksi)
VITE_API_URL=https://api.your-domain.com
VITE_APP_DOMAIN=your-domain.com
