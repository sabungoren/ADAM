# ==========================================================================
# SMART ADAM - Frontend Environment Template (.env.example)
# PENTING: Salin file ini menjadi '.env' di folder Frontend.
# File .env sudah dimasukkan ke .gitignore agar kredensial rahasia tidak bocor ke GitHub!
# ==========================================================================

VITE_PORT=5193
VITE_SUPABASE_URL=https://[YOUR-PROJECT-ID].supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Alternative Next.js-style variable aliases
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Gmail SMTP Configuration for OTP Authentication
VITE_SMTP_HOST=smtp.gmail.com
VITE_SMTP_PORT=465
VITE_SMTP_USER=your_email@gmail.com
VITE_SMTP_PASS=your_gmail_app_password
VITE_SMTP_FROM_NAME="SMART ADAM System"

# ==========================================================================
# PRODUCTION DOMAIN & CLOUDFLARE TUNNEL (STB DEPLOYMENT)
# ==========================================================================
VITE_SITE_URL=
VITE_APP_URL=
VITE_SUPABASE_REDIRECT_URL=
