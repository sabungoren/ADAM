# ==============================================================================
# Project A.D.A.M - Backend Environment Variables Template (.env.example)
# Salin file ini menjadi .env lalu sesuaikan dengan konfigurasi server Anda.
# PENTING: Jangan masukkan password atau kredensial rahasia asli ke file ini!
# ==============================================================================

# Server Network Configuration
PORT=5194
HOST=0.0.0.0
DATABASE_PATH=./data/adam.db

# MQTT Broker Configuration
MQTT_BROKER=mqtt://127.0.0.1:1883
MQTT_USERNAME=your_mqtt_username
MQTT_PASSWORD=your_mqtt_secret_password
EMBEDDED_MQTT=true

# Administrator Account & Session Security
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_secret_password
SESSION_SECRET=generate_random_64_character_secret_key_here

# Domain & CORS Configuration (Sesuaikan dengan domain atau IP Anda)
CORS_ORIGIN=https://your-domain.com
API_DOMAIN=api.your-domain.com
FRONTEND_DOMAIN=your-domain.com
